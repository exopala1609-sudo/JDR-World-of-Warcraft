      "deDeVie": 10,
      "caracteristiquesPrincipales": ["force", "constitution"],
      "maitriseSauvegardes": ["force", "constitution"],
      "ressources": [{ "ressource": "rage" }, { "ressource": "second-souffle" }]
    },
    {
      "id": "paladin",
      "nom": "Paladin",
      "description": "Champion de la Lumière, il protège ses alliés et châtie le mal.",
      "couleur": "#f48cba",
      "deDeVie": 10,
      "caracteristiquesPrincipales": ["force", "charisme"],
      "maitriseSauvegardes": ["sagesse", "charisme"],
      "caracteristiqueIncantation": "charisme",
      "progressionSorts": "demi",
      "ressources": [{ "ressource": "mana" }, { "ressource": "puissance-sacree" }]
    },
